{
  "expo": {
    "name": "Pozume",
    "slug": "pozume",
    "version": "0.7.0",
    "orientation": "portrait",
    "scheme": "pozume",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "de.inthielligent.pozume",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Pozume schützt deine Notizen mit Face ID.",
        "NSCameraUsageDescription": "Pozume kann Fotos aufnehmen und als Anhang an Notizen anfügen."
      },
      "buildNumber": "5"
    },
    "android": {
      "package": "de.inthielligent.pozume"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f7fb"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "mode": "broadcast"
        }
      ],
      "expo-asset"
    ]
  }
}
